# Kopier til .env og juster verdiene

# PostgreSQL
DATABASE_URL="postgresql://heimet:heimet@localhost:5432/heimet"

# better-auth — generer en lang tilfeldig streng: `openssl rand -base64 32`
BETTER_AUTH_SECRET="bytt-meg-til-noe-hemmelig"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP (Mailpit i dev: docker compose up -d)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EPOST_FRA="Heimet <ikke-svar@heimet.no>"

# Filopplasting: "disk" (dev) eller "s3"
LAGRING_DRIVER="disk"
LAGRING_DISK_STI="./opplastinger"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="heimet"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Hemmelighet for cron-endepunkter (ukesbrev m.m.)
CRON_SECRET="bytt-meg-ogsaa"
